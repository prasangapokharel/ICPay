{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "ICP_STATIC_EXPORT": "0"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false,
      "dev": false,
      "feat/**": false,
      "fix/**": false
    }
  },
  "redirects": [
    {
      "source": "/icbucket",
      "has": [{ "type": "host", "value": "bucket.icpay.app" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/icfalcon",
      "has": [{ "type": "host", "value": "falcon.icpay.app" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bucket/docs",
      "has": [{ "type": "host", "value": "docs.icpay.app" }],
      "destination": "/",
      "permanent": true
    },
    { "source": "/what-is-icp", "destination": "/blog/what-is-icp", "permanent": true },
    { "source": "/best-crypto-wallet", "destination": "/blog/best-crypto-wallet", "permanent": true },
    { "source": "/best-icp-wallet", "destination": "/blog/best-icp-wallet", "permanent": true },
    { "source": "/what-is-internet-identity", "destination": "/blog/what-is-internet-identity", "permanent": true },
    { "source": "/how-to-send-icp", "destination": "/blog/how-to-send-icp", "permanent": true },
    { "source": "/icp-price", "destination": "/blog/icp-price", "permanent": true },
    { "source": "/icp-cloud-storage", "destination": "/blog/icp-cloud-storage", "permanent": true },
    { "source": "/internet-computer-chain-fusion", "destination": "/blog/internet-computer-chain-fusion", "permanent": true },
    { "source": "/how-icp-canisters-work", "destination": "/blog/how-icp-canisters-work", "permanent": true },
    { "source": "/icp-cycles-explained", "destination": "/blog/icp-cycles-explained", "permanent": true },
    { "source": "/icp-vs-ethereum", "destination": "/blog/icp-vs-ethereum", "permanent": true },
    { "source": "/can-icp-replace-cloud-computing", "destination": "/blog/can-icp-replace-cloud-computing", "permanent": true },
    { "source": "/icp-stable-memory", "destination": "/blog/icp-stable-memory", "permanent": true },
    { "source": "/icp-subnets-explained", "destination": "/blog/icp-subnets-explained", "permanent": true },
    { "source": "/icp-reverse-gas-model", "destination": "/blog/icp-reverse-gas-model", "permanent": true },
    { "source": "/icp-https-outcalls", "destination": "/blog/icp-https-outcalls", "permanent": true },
    { "source": "/how-to-stake-icp", "destination": "/blog/how-to-stake-icp", "permanent": true },
    { "source": "/icpay-bucket-sdk", "destination": "/blog/icpay-bucket-sdk", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "bucket.icpay.app" }],
      "destination": "/icbucket"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "falcon.icpay.app" }],
      "destination": "/icfalcon"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "docs.icpay.app" }],
      "destination": "/bucket/docs"
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "docs.icpay.app" }],
      "destination": "/bucket/docs/:path+"
    },
    {
      "source": "/cloud/:bucket/:path*",
      "has": [{ "type": "host", "value": "cloud.icpay.app" }],
      "destination": "/api/cloud/:bucket/:path*"
    },
    {
      "source": "/icpverse/:username",
      "destination": "/icpverse/profile"
    },
    {
      "source": "/token/:ledgerId/deposit",
      "destination": "/token/token/deposit"
    },
    {
      "source": "/token/:ledgerId",
      "destination": "/token/token"
    },
    {
      "source": "/launch/:id",
      "destination": "/launch/id"
    },
    {
      "source": "/bucket/docs",
      "destination": "/bucket/docs"
    },
    {
      "source": "/bucket/pricing",
      "destination": "/bucket/pricing"
    },
    {
      "source": "/bucket/:id",
      "destination": "/bucket/id"
    },
    {
      "source": "/live/:id",
      "destination": "/live/id"
    },
    {
      "source": "/channels/join/:slug",
      "destination": "/channels/join/:slug"
    },
    {
      "source": "/channels/:slug/:messageId",
      "destination": "/channels/:slug/:messageId"
    },
    {
      "source": "/channels/:slug",
      "destination": "/channels/:slug"
    },
    {
      "source": "/:username([A-Za-z0-9_]{1,8})",
      "destination": "/u"
    }
  ]
}
