{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "ICP_STATIC_EXPORT": "0"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false,
      "dev": false
    }
  },
  "rewrites": [
    {
      "source": "/:bucket/:path*",
      "has": [{ "type": "host", "value": "cloud.icpay.app" }],
      "destination": "/api/cloud/:bucket/:path*"
    },
    {
      "source": "/icpverse/:username",
      "destination": "/icpverse/profile"
    },
    {
      "source": "/token/:ledgerId",
      "destination": "/token/token"
    },
    {
      "source": "/launch/:id",
      "destination": "/launch/id"
    },
    {
      "source": "/bucket/docs",
      "destination": "/bucket/docs"
    },
    {
      "source": "/bucket/pricing",
      "destination": "/bucket/pricing"
    },
    {
      "source": "/bucket/:id",
      "destination": "/bucket/id"
    },
    {
      "source": "/:username([A-Za-z0-9_]{1,8})",
      "destination": "/u"
    }
  ]
}
