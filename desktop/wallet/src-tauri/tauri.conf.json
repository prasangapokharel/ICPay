{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ICPay",
  "version": "1.0.0",
  "identifier": "app.icpay.wallet",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://icpay.app/login",
    "beforeBuildCommand": "npm run build:shell",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "ICPay wallet for Internet Computer",
    "longDescription": "Native ICPay wallet — sign in and manage your custodial ICP wallet.",
    "category": "Finance",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
