# Local tooling and operating-system files
.opencode/
.cursor/
.windsurf/
# Points at itself, so it resolves to nothing. The real skill lives in the
# global ~/.claude/skills/ and is not part of this repo.
frontend/.agents/skills/vercel-react-best-practices
# Anchored to the root: these are the per-machine agent instruction files. The
# leading slash matters -- unanchored, they would also swallow .claude/AGENTS.md
# and frontend/AGENTS.md, which are committed on purpose.
/AGENTS.md
/CLAUDE.md
.DS_Store
# .claude/ carries the agent map -- the point of it is that a fresh clone gets
# the same context. Only the per-machine permission grants stay local.
.claude/settings.local.json
# Only the README screenshots and the command reference are public. git will not
# descend into an excluded directory, so this excludes the contents rather than
# the directory itself -- otherwise the negations below could never match.
docs/*
!docs/demo/
!docs/command/
!docs/language/
!docs/workflow.md
!docs/security/

# Environment files and credentials
**/.env*
!**/.env.example
backend/freemodel/cookies.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
# dfx identities are the keys to the canister; an exported one must never be
# committed, and identity.json carries the active identity's material.
**/identity.json
**/.config/dfx/
*.identity.json
seed.txt
mnemonic.txt

# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Backend dependencies and local canister output
backend/.dfx/
backend/.mops/
.dfx/

# Package-manager and debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# staged Next export for the asset canister
backend/dist/
node_modules/
