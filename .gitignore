# Local tooling and operating-system files
.claude/
.agents/
.opencode/
.cursor/
.windsurf/
AGENTS.md
CLAUDE.md
.DS_Store
# git will not descend into an excluded directory, so this has to exclude the
# contents rather than the directory itself for the launch runbook to survive.
docs/*
!docs/launch/
!docs/costing/

# Environment files and credentials
**/.env*
!**/.env.example
backend/freemodel/cookies.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
# dfx identities are the keys to the canister; an exported one must never be
# committed, and identity.json carries the active identity's material.
**/identity.json
**/.config/dfx/
*.identity.json
seed.txt
mnemonic.txt

# Frontend dependencies and build output
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Backend dependencies and local canister output
backend/.dfx/
backend/.mops/
.dfx/

# Package-manager and debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# staged Next export for the asset canister
backend/dist/

# Local task runner scripts, kept out of the repo for now
ci/
