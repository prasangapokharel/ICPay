{
  "canisters": {
    "icp_wallet_backend": {
      "type": "motoko",
      "main": "src/main.mo",
      "dependencies": ["icp_ledger"],
      "metadata": [{ "name": "candid:service" }]
    },
    "icp_wallet_frontend": {
      "type": "assets",
      "source": ["dist"],
      "build": ["bash scripts/build-frontend.sh"]
    },
    "icp_ledger": {
      "type": "pull",
      "id": "ryjl3-tyaaa-aaaaa-aaaba-cai"
    },
    "icpay_trade": {
      "candid": "rust/trade/icpay_trade.did",
      "package": "icpay_trade",
      "crate": "icpay_trade",
      "type": "rust"
    },
    "icp_blob_store": {
      "type": "motoko",
      "main": "blob_store/src/main.mo",
      "init_arg": "(principal \"6vbhm-nqaaa-aaaan-q6muq-cai\")",
      "metadata": [{ "name": "candid:service" }]
    },
    "internet_identity": {
      "type": "custom",
      "candid": "deps/local/internet_identity.did",
      "wasm": "deps/local/internet_identity.wasm.gz",
      "build": [],
      "specified_id": "rdmx6-jaaaa-aaaaa-aaadq-cai",
      "remote": { "id": { "ic": "rdmx6-jaaaa-aaaaa-aaadq-cai" } }
    },
    "test_icp_ledger": {
      "type": "custom",
      "candid": "/tmp/icp_ledger.did",
      "wasm": "/tmp/icp_ledger_canister.wasm.gz",
      "build": []
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "networks": {
    "ic": {
      "providers": [
        "https://icp0.io",
        "https://icp-api.io",
        "https://ic0.app"
      ],
      "type": "persistent"
    }
  },
  "version": 1
}
