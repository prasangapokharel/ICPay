{
  "meta": {
    "name": "ICPay Mobile App — Screen & API Reference",
    "version": "1.0.0",
    "updated": "2026-08-17",
    "purpose": "Single source of truth for React Native app: every screen, which APIs it calls, query vs update, and auth requirements.",
    "webReference": "https://icpay.app",
    "backendCanisterId": "6vbhm-nqaaa-aaaan-q6muq-cai",
    "frontendAssetCanisterId": "63dke-waaaa-aaaan-q6mvq-cai",
    "icHost": "https://icp0.io",
    "internetIdentityUrl": "https://id.ai",
    "derivationOrigin": "https://63dke-waaaa-aaaan-q6mvq-cai.icp0.io"
  },

  "queryVsUpdate": {
    "rule": "IC queries cost the canister ~$0. Prefer query paths for reads. Updates cost cycles and move state or touch ledgers.",
    "preferQuery": [
      "getDashboard",
      "getTransactions",
      "getDepositAddress",
      "getUser",
      "checkUsername",
      "searchUsers",
      "resolveUsername",
      "isLedgerSupported",
      "getToken / getTokenById / listTokens",
      "getBucket* (most bucket reads)",
      "getUserAnalytics",
      "getVerifiedTier",
      "icrc1_balance_of (direct ledger)",
      "icrc1_metadata (direct ledger)",
      "ICPSwap factory.getPool + pool.quote (browser/RN agent)"
    ],
    "mustUpdate": [
      "login",
      "register",
      "transfer*",
      "withdraw",
      "syncDeposits",
      "executeSwap",
      "recoverFailedSwapInput",
      "purchaseUsername",
      "launchToken",
      "createBucket / uploadFile / renewBucket",
      "exportUserAnalytics",
      "updateSettings (getSettings is also update — see quirks)"
    ],
    "quirks": [
      "getSettings is implemented as update, not query — cache aggressively on mobile.",
      "Backend getSwapQuote is update — web app uses ICPSwap direct queries instead (see externalApis.swapQuote).",
      "Never change derivationOrigin on mobile without matching ii-alternative-origins."
    ]
  },

