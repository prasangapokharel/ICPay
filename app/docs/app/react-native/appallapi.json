  "auth": {
    "provider": "Internet Identity (AuthClient + delegation)",
    "optionalProviders": ["NFID — different principal, separate wallet"],
    "flow": [
      "1. AuthClient.login({ identityProvider, derivationOrigin })",
      "2. actor.login() — backend creates/loads user row",
      "3. actor.register(username) — if isNew and user picks free name (5+ chars)",
      "4. Store identity in secure storage; reuse HttpAgent per session"
    ],
    "sessionEndpoints": {
      "login": { "kind": "update", "returns": "AuthResult { user, isNew }" },
      "register": { "kind": "update", "args": ["username"], "returns": "AuthResult" },
      "getUser": { "kind": "query", "returns": "opt UserPublic" }
    },
    "guards": {
      "appShell": "All (app)/* routes require II session",
      "public": ["/login", "/[username] public profile", "/about", "/faq", "/terms", "/privacy"]
    }
  },

