  "backendApi": {
    "canisterId": "6vbhm-nqaaa-aaaan-q6muq-cai",
    "actorFactory": "frontend/services/wallet.ts — walletIdl + Actor.createActor",
    "resultWrapper": "{ ok: T } | { err: text }",
    "modules": {
      "Health": {
        "health": { "kind": "query", "auth": false, "returns": "text" }
      },
      "Auth": {
        "login": { "kind": "update", "auth": "II", "returns": "AuthResult" },
        "register": { "kind": "update", "auth": "II", "args": ["username"], "returns": "AuthResult" }
      },
      "Users": {
        "getUser": { "kind": "query", "auth": "II", "returns": "opt UserPublic" },
        "updateUsername": { "kind": "update", "auth": "II", "args": ["newUsername"] },
        "checkUsername": { "kind": "query", "auth": false, "args": ["name"], "returns": "bool" },
        "searchUsers": { "kind": "query", "auth": false, "args": ["searchText"], "returns": "[UserPublic]" },
        "resolveUsername": { "kind": "query", "auth": false, "args": ["name"], "returns": "opt Principal" },
        "getUsernameCount": { "kind": "query", "auth": false, "returns": "Nat" }
      },
      "Dashboard": {
        "getDashboard": { "kind": "query", "auth": "II", "args": ["ledgerId"], "returns": "ApiResult DashboardData" }
      },
      "Deposit": {
        "getDepositAddress": { "kind": "query", "auth": "II", "returns": "ICRC1Account" },
        "getDepositAccountIdentifier": { "kind": "query", "auth": "II", "returns": "Text" },
        "syncDeposits": { "kind": "update", "auth": "II", "args": ["ledgerId"] }
      },
      "Withdraw": {
        "withdraw": { "kind": "update", "auth": "II", "args": ["ledgerId", "amount", "to"] }
      },
      "Transfer": {
        "transferByUsername": { "kind": "update", "auth": "II", "args": ["ledgerId", "username", "amount", "memo?"] },
        "transferByPrincipal": { "kind": "update", "auth": "II", "args": ["ledgerId", "principal", "amount", "memo?"] },
        "transferByAccount": { "kind": "update", "auth": "II", "args": ["ledgerId", "account", "amount", "memo?"] },
        "transferByAccountId": { "kind": "update", "auth": "II", "args": ["accountId", "amount", "memo?"] }
      },
      "Transactions": {
