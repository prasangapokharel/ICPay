        { "name": "icrc1_fee", "source": "ledger", "kind": "query", "when": "fee estimate" },
        { "name": "transferByUsername", "source": "backend", "kind": "update", "args": ["ledgerId", "username", "amount", "memo?"] },
        { "name": "transferByPrincipal", "source": "backend", "kind": "update", "args": ["ledgerId", "principal", "amount", "memo?"] },
        { "name": "transferByAccount", "source": "backend", "kind": "update", "args": ["ledgerId", "account", "amount", "memo?"] },
        { "name": "transferByAccountId", "source": "backend", "kind": "update", "args": ["accountId", "amount", "memo?"], "note": "ICP only" }
