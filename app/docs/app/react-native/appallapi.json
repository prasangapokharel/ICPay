        { "name": "getDashboard", "source": "backend", "kind": "query", "args": ["ledgerId=ICP"], "cache": "5min SWR" },
        { "name": "icrc1_balance_of", "source": "icp-ledger", "kind": "query", "note": "Live ICP balance via useLiveBalance" },
        { "name": "getUser", "source": "backend", "kind": "query", "optional": true }
